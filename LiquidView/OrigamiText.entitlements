<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Reference verification (Preflight) queries Crossref and similar
	     web services over HTTPS. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The letter post scripts Apple Mail: composing and sending
	     published letters, and reading recent inbox messages to save
	     arriving .origamitext attachments into the community folder.
	     Under the App Sandbox, automation.apple-events alone does not
	     authorize events to Mail — the target must be named here.
	     Mail's public scripting access group (com.apple.mail.compose)
	     covers only composing, so receiving needs this exception. -->
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.mail</string>
	</array>
</dict>
</plist>
